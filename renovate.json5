{
  $schema: 'https://docs.renovatebot.com/renovate-schema.json',
  extends: [
    'local>SlashNephy/renovate-config',
  ],
  ignorePaths: [
    // 退役済みのマニフェストは更新しない
    'k8s/*/_retired/**',
  ],
  packageRules: [
    // 重要コンポーネントの更新を迅速化
    {
      matchFileNames: [
        'k8s/system/**'
      ],
      minimumReleaseAge: null,
    },
    // 自作イメージの更新を迅速化
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/slashnephy/**',
        'ghcr.io/starrybluesky/**',
      ],
      minimumReleaseAge: null,
      versioning: 'loose',
    },
    // FileBrowser Quantum は stable と beta のタグを併走させているため、stable のみを追従する
    {
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'gtstef/filebrowser',
      ],
      versioning: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-stable$',
    },
    // Go グループ化
    {
      groupName: 'Go',
      matchPackageNames: [
        'golang/go', // Docker イメージ
        'golang', // mise
      ],
    },
    // Immich グループ化
    {
      groupName: 'immich',
      matchDatasources: [
        'docker',
      ],
      matchPackageNames: [
        'ghcr.io/immich-app/**',
      ],
    },
    // OCI イメージで参照されるチャートで pinDigest を無効化する
    // https://github.com/renovatebot/renovate/discussions/38038
    {
      matchManagers: [
        'kustomize',
      ],
      matchDepNames: [
        'influxdb',
        'mariadb',
        'postgresql',
        'redis',
        'valkey',
        'cert-manager',
        'n8n',
        'gha-runner-scale-set-controller',
        'gha-runner-scale-set',
        'openclaw-operator',
        'librechat',
        'grafana',
        'loki',
      ],
      pinDigest: {
        enabled: false,
      },
    },
  ],
  customManagers: [
    // CloudNativePG の Cluster の imageName
    // https://github.com/cloudnative-pg/postgres-containers#automated-updates-with-renovate
    {
      customType: 'regex',
      managerFilePatterns: [
        '/\\.yaml$/',
      ],
      matchStrings: [
        'imageName:[ \\t]*(?<depName>ghcr\\.io/cloudnative-pg/postgresql):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?',
      ],
      datasourceTemplate: 'docker',
      versioningTemplate: 'regex:^(?<major>\\d+)\\.(?<minor>\\d+)-(?<patch>\\d+)-(?<compatibility>\\S+)$',
      autoReplaceStringTemplate: 'imageName: {{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}',
    },
    // OpenClaw
    {
      customType: 'regex',
      managerFilePatterns: [
        'k8s/apps/openclaw/resources/instance.yaml',
      ],
      matchStrings: [
        'repository:\\s*(?<depName>[^\\s]+)\\s*\\n\\s*tag:\\s*(?<currentValue>[^\\s]+)\\s*\\n\\s*digest:\\s*(?<currentDigest>sha256:[a-f0-9]+)',
      ],
      datasourceTemplate: 'docker',
    },
    // kustomize マネージャーは helmCharts[].valuesInline 内のイメージを拾わない
    {
      customType: 'regex',
      managerFilePatterns: [
        'k8s/system/mackerel-operator/kustomization.yaml',
      ],
      matchStrings: [
        'repository:\\s*(?<depName>[^\\s]+)\\s*\\n\\s*tag:\\s*(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]+))?',
      ],
      datasourceTemplate: 'docker',
    },
  ],
  rebaseWhen: 'conflicted',
}
